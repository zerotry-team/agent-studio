}

model capability_gaps {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String   @db.Uuid
  project_id          String   @db.Uuid
  requirement         String
  gap_type            String
  resolution_strategy String
  status              String   @default("open")
  detail              Json     @default("{}")
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization organizations    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      builder_projects @relation(fields: [organization_id, project_id], references: [organization_id, id], onDelete: Cascade)

  @@unique([organization_id, id])
  @@index([project_id, status])
}

/// Secret の値は持たない。入力項目と再開条件だけを型付きで保存する。
model human_actions {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String    @db.Uuid
  project_id       String    @db.Uuid
  type             String
  title            String
  reason           String
  assignee_role    String
  fields           Json      @default("[]")
  instructions     Json      @default("[]")
  resume_condition Json
  /// Business clarification answers only. Secret fields are never accepted here.
  response         Json?
  status           String    @default("pending")
  completed_by     String?   @db.Uuid
  completed_at     DateTime? @db.Timestamptz(6)
  expires_at       DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  organization organizations    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      builder_projects @relation(fields: [organization_id, project_id], references: [organization_id, id], onDelete: Cascade)

  @@unique([organization_id, id])
  @@index([project_id, status])
}

/// Builderが参照した仕様の来歴。仕様本文やSecretは保存せず、検証可能なハッシュと抽出結果だけを持つ。
model builder_discovery_sources {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  project_id      String   @db.Uuid
  kind            String
  title           String
  spec_version    String?
  source_url      String?
  content_hash    String
  metadata        Json     @default("{}")
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization organizations    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      builder_projects @relation(fields: [organization_id, project_id], references: [organization_id, id], onDelete: Cascade)

  @@unique([organization_id, id])
  @@index([project_id, created_at(sort: Desc)])
}

/// Connector / Tool / code / infraへ加えた生成差分の固定記録。Secretや仕様本文は含めない。
model builder_change_sets {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  project_id      String   @db.Uuid
  kind            String
  status          String
  summary         String
  risk            String
  artifacts       Json     @default("[]")
  source_hash     String?
  base_sha        String?
  head_sha        String?
  pr_url          String?
  pr_number       Int?
  merge_sha       String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization organizations                @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      builder_projects             @relation(fields: [organization_id, project_id], references: [organization_id, id], onDelete: Cascade)
  sessions     builder_workspace_sessions[]
  packages     builder_adapter_packages[]

  @@unique([organization_id, id])
  @@index([project_id, created_at(sort: Desc)])
}

/// merge済みcommitから生成した署名付き・不変のAdapter成果物。package本文やSecretは保持しない。
model builder_adapter_packages {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  project_id      String    @db.Uuid
  change_set_id   String    @db.Uuid
  runtime_id      String    @db.Uuid
  status          String    @default("pending")
  connector_key   String
  descriptor_hash String
  contract_hash   String
  source_commit   String
  image_digest    String
  signature       String
  provenance      Json      @default("{}")
  health_status   String    @default("pending")
  error_class     String?
  error           String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  deployed_at     DateTime? @db.Timestamptz(6)
  registered_at   DateTime? @db.Timestamptz(6)

  organization organizations       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      builder_projects    @relation(fields: [organization_id, project_id], references: [organization_id, id], onDelete: Cascade)
  change_set   builder_change_sets @relation(fields: [organization_id, change_set_id], references: [organization_id, id], onDelete: Cascade)
  runtime      runtimes            @relation(fields: [organization_id, runtime_id], references: [organization_id, id], onDelete: Restrict)

  @@unique([change_set_id])
  @@unique([organization_id, id])
  @@unique([organization_id, connector_key, image_digest])
  @@index([runtime_id, status])
}

/// GitHub webhookのdelivery IDを保存し、署名検証済みイベントを冪等に処理する。
model git_webhook_deliveries {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  delivery_id     String
  event           String
  repository_id   String
  payload_hash    String
  processed_at    DateTime @default(now()) @db.Timestamptz(6)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, delivery_id])
  @@unique([organization_id, id])
}

/// BuilderのCode Workspace Change SetごとのAgents API Session。prompt本文、生成コード、Environment Keyは保持しない。
model builder_workspace_sessions {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id       String    @db.Uuid
  project_id            String    @db.Uuid
  change_set_id         String    @db.Uuid
  runtime_id            String    @db.Uuid
  openai_session_id     String?   @unique
  openai_environment_id String?
  /// creating / waiting_worker / connected / running / succeeded / failed / cancelled / expired
  status                String    @default("creating")
  attempt               Int       @default(1)
  lease_owner           String?
  lease_until           DateTime? @db.Timestamptz(6)
  expires_at            DateTime  @db.Timestamptz(6)
  last_event_at         DateTime? @db.Timestamptz(6)
  prompt_hash           String
  result_hash           String?
  error_class           String?
  error                 String?
  /// Tool Gatewayとの互換用。平文tokenは保存しない。
  token_hash            String
  worker_task_arn       String?
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  finished_at           DateTime? @db.Timestamptz(6)

  organization organizations       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      builder_projects    @relation(fields: [organization_id, project_id], references: [organization_id, id], onDelete: Cascade)
  change_set   builder_change_sets @relation(fields: [organization_id, change_set_id], references: [organization_id, id], onDelete: Cascade)
  runtime      runtimes            @relation(fields: [organization_id, runtime_id], references: [organization_id, id], onDelete: Restrict)

  @@unique([change_set_id, attempt])
  @@unique([organization_id, id])
  @@index([status, lease_until, created_at])
  @@index([runtime_id, status])
}

/// Contract / Security / Smoke / Previewの検証結果。証拠は非機微な構造化情報だけを保存する。
model builder_validation_runs {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  project_id      String    @db.Uuid
  suite           String
  environment     String
  status          String
  evidence        Json      @default("{}")
  error_class     String?
  error           String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  finished_at     DateTime? @db.Timestamptz(6)

  organization organizations    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      builder_projects @relation(fields: [organization_id, project_id], references: [organization_id, id], onDelete: Cascade)

  @@unique([organization_id, id])
  @@index([project_id, created_at(sort: Desc)])
}

/// Builderが生成したAgentとPreview Build/Runを1つに固定するリリース候補。
model builder_releases {
  id                            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id               String    @db.Uuid
  project_id                    String    @db.Uuid
  builder_run_id                String    @db.Uuid
  agent_id                      String    @db.Uuid
  build_id                      String    @db.Uuid
  preview_deployment_id         String    @db.Uuid
  preview_run_id                String?   @db.Uuid
  production_deployment_id      String?   @db.Uuid
  production_run_id             String?   @db.Uuid
  rollback_target_deployment_id String?   @db.Uuid
  status                        String    @default("preview_ready")
  config_hash                   String
  required_tools                String[]  @default([])
  created_at                    DateTime  @default(now()) @db.Timestamptz(6)
  finished_at                   DateTime? @db.Timestamptz(6)

  organization       organizations    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project            builder_projects @relation(fields: [organization_id, project_id], references: [organization_id, id], onDelete: Cascade)
  builder_run        builder_runs     @relation(fields: [organization_id, builder_run_id], references: [organization_id, id], onDelete: Restrict)
  agent              agents           @relation(fields: [organization_id, agent_id], references: [organization_id, id], onDelete: Restrict)
  build              agent_builds     @relation(fields: [organization_id, build_id], references: [organization_id, id], onDelete: Restrict)
  preview_deployment deployments      @relation(fields: [organization_id, preview_deployment_id], references: [organization_id, id], onDelete: Restrict)
  preview_run        runs?            @relation(fields: [organization_id, preview_run_id], references: [organization_id, id], onDelete: Restrict)

  @@unique([organization_id, id])
  @@unique([builder_run_id])
  @@index([project_id, created_at(sort: Desc)])
  @@index([status, created_at])
  @@index([production_run_id])
}

/// 監査ログ（AUD）。アプリのロールには INSERT / SELECT しか与えない
model audit_logs {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 組織が特定できない操作（Runtime 認証の失敗など）は null
  organization_id String?  @db.Uuid
  /// user / runtime / system
  actor_type      String
  actor_id        String?
  actor_label     String?
  action          String
  target_type     String?
  target_id       String?
  /// success / failure / denied
  result          String
  detail          Json     @default("{}")
  source_ip       String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organization_id, created_at(sort: Desc)])
}
