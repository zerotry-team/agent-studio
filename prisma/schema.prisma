// Agent Studio（Control Plane）の DB スキーマ
//
// 組織の分離（SEC-01 / SEC-04 / SEC-16）
// - 組織に属するテーブルは organization_id を持ち、RLS（migrations の SQL）で自組織の行だけに制限する
// - 別テーブルへの参照は (organization_id, id) の複合外部キーにして、組織をまたいだ参照を DB で禁止する
// - アプリは RLS が効くロール（agent_studio_app）で接続する。マイグレーションはテーブル所有者で行う

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Control Plane Workerの生存確認。組織データを持たない運用メタデータ。
model worker_heartbeats {
  worker_id       String   @id
  version         String?
  active_runs     Int      @default(0)
  active_sessions Int      @default(0)
  last_seen_at    DateTime @default(now()) @db.Timestamptz(6)
  started_at      DateTime @default(now()) @db.Timestamptz(6)
}

model organizations {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  name        String
  status      String   @default("active")
  /// production / test。通常Workerとintegration workerのqueueをDB境界で分離する。
  worker_pool String   @default("production")
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  openai_settings                organization_openai_settings?
  members                        organization_members[]
  agents                         agents[]
  agent_versions                 agent_versions[]
  connectors                     connectors[]
  tools                          tools[]
  tool_versions                  tool_versions[]
  connections                    connections[]
  connection_links               agent_connection_links[]
  environment_configs            agent_environment_configs[]
  builds                         agent_builds[]
  policies                       policies[]
  auto_approval_policy           organization_auto_approval_policies?
  auto_approval_policy_versions  organization_auto_approval_policy_versions[]
  runtimes                       runtimes[]
  bootstrap_tokens               runtime_bootstrap_tokens[]
  runtime_profiles               runtime_profiles[]
  deployments                    deployments[]
  runs                           runs[]
  run_inputs                     run_inputs[]
  sessions                       agent_sessions[]
  run_events                     run_events[]
  approvals                      approvals[]
  runtime_jobs                   runtime_jobs[]
  workflows                      workflows[]
  workflow_runs                  workflow_runs[]
  eval_cases                     eval_cases[]
  eval_runs                      eval_runs[]
  external_jobs                  external_jobs[]
  agent_schedules                agent_schedules[]
  builder_projects               builder_projects[]
  builder_runs                   builder_runs[]
  builder_steps                  builder_steps[]
  capability_plans               capability_plans[]
  capability_gaps                capability_gaps[]
  human_actions                  human_actions[]
  builder_sources                builder_discovery_sources[]
  builder_changes                builder_change_sets[]
  builder_sessions               builder_workspace_sessions[]
  builder_validations            builder_validation_runs[]
  builder_releases               builder_releases[]
  adapter_packages               builder_adapter_packages[]
  git_webhook_events             git_webhook_deliveries[]
  deployment_api_keys            deployment_api_keys[]
  deployment_webhooks            deployment_webhooks[]
  deployment_trigger_invocations deployment_trigger_invocations[]
  run_artifacts                  run_artifacts[]
  browser_profiles               browser_profiles[]
  browser_login_sessions         browser_login_sessions[]
}

/// 組織ごとの OpenAI Project とキーの保管場所（SEC-11）。キーの値は持たない
model organization_openai_settings {
  organization_id              String   @id @db.Uuid
  openai_project_id            String?
  app_key_secret_arn           String?
  env_key_secret_arn           String?
  orcarouter_key_secret_arn    String?
  orcarouter_text_enabled      Boolean  @default(false)
  orcarouter_image_enabled     Boolean  @default(false)
  orcarouter_text_model        String   @default("google/gemini-2.5-pro")
  orcarouter_image_model       String   @default("openai/gpt-image-1")
  updated_at                   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model users {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 認証基盤（Cognito）の sub。招待直後でまだログインしていない場合は null
  auth_subject      String?  @unique
  email             String   @unique
  display_name      String?
  is_platform_admin Boolean  @default(false)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  memberships organization_members[]
}

model organization_members {
  organization_id String   @db.Uuid
  user_id         String   @db.Uuid
  /// owner / admin / builder / operator / viewer
  role            String
  is_approver     Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         users         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([organization_id, user_id])
  @@index([user_id])
}

model agents {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id         String   @db.Uuid
  key                     String
  name                    String
  description             String?
  /// 利用者が入力した業務説明。Manifest は Advanced 表示に留める
  project_brief           String?
  /// Capability Resolver の直近結果。Secret は含めない
  capability_resolution   Json     @default("{}")
  /// ブラウザで接続してよい範囲。"restricted"（許可したドメインだけ）か "public"（公開Web全般）
  browser_access          String   @default("restricted")
  /// restricted のときに接続を許すドメイン
  browser_allowed_domains Json     @default("[]")
  latest_version          Int      @default(0)
  created_by              String?  @db.Uuid
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization        organizations               @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  versions            agent_versions[]
  deployments         deployments[]
  eval_cases          eval_cases[]
  connection_links    agent_connection_links[]
  environment_configs agent_environment_configs[]
  builds              agent_builds[]
  schedules           agent_schedules[]
  builder_releases    builder_releases[]
  builder_projects    builder_projects[]

  @@unique([organization_id, key])
  @@unique([organization_id, id])
}

model agent_versions {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  agent_id        String    @db.Uuid
  version         Int
  /// draft / published / archived。published は変更不可（AGT-02）
  status          String    @default("draft")
  manifest        Json
  manifest_yaml   String
  created_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  published_at    DateTime? @db.Timestamptz(6)

  organization organizations  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  agent        agents         @relation(fields: [organization_id, agent_id], references: [organization_id, id], onDelete: Cascade)
  deployments  deployments[]
  builds       agent_builds[]

  @@unique([agent_id, version])
  @@unique([organization_id, id])
}

/// 利用者に見せる連携サービス。配下の Tool は権限・リスク・監査の単位として分離したまま維持する
model connectors {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id             String   @db.Uuid
  key                         String
  name                        String
  description                 String
  /// http_openapi / mcp / internal / openai_builtin / runtime
  adapter                     String
  base_url                    String?
  /// none / static_bearer / runtime_secret
  auth_type                   String   @default("none")
  /// OAuth appの公開識別子。Client Secret本体はSecret Storeへ保存する
  oauth_client_id             String?
  oauth_client_secret_locator String?
  icon                        String?
  created_at                  DateTime @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization  organizations            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  tools         tools[]
  connections   connections[]
  links         agent_connection_links[]
  external_jobs external_jobs[]

  @@unique([organization_id, key])
  @@unique([organization_id, id])
}

model tools {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String   @db.Uuid
  connector_id       String?  @db.Uuid
  name               String
  display_name       String
  /// studio_function / openai_service_mcp / runtime_mcp
  execution_location String
  risk               String
  latest_version     Int      @default(1)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization organizations   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  connector    connectors?     @relation(fields: [organization_id, connector_id], references: [organization_id, id], onDelete: Restrict)
  versions     tool_versions[]

  @@unique([organization_id, name])
  @@unique([organization_id, id])
}

model tool_versions {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  tool_id         String   @db.Uuid
  version         Int
  spec            Json
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  tool         tools         @relation(fields: [organization_id, tool_id], references: [organization_id, id], onDelete: Cascade)

  @@unique([tool_id, version])
  @@unique([organization_id, id])
}

/// 接続先（CONN）。認証情報の値は持たず、保管場所（secret_locator）だけを持つ
model connections {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String    @db.Uuid
  connector_id        String?   @db.Uuid
  name                String
  description         String?
  /// studio / openai_vault / runtime
  scope               String
  runtime_id          String?   @db.Uuid
  runtime_secret_name String?
  header_name         String?
  /// Provider固有の非機微メタデータ。GitHub Appではinstallation/repository allowlistと権限だけを保持する。
  metadata            Json      @default("{}")
  /// studio: Secrets Manager の ARN / openai_vault: "vault_id" または "vault_id:credential_id"
  secret_locator      String?
  /// connected / expired / revoked / error
  status              String    @default("connected")
  last_validated_at   DateTime? @db.Timestamptz(6)
  expires_at          DateTime? @db.Timestamptz(6)
  revoked_at          DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  organization organizations            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  connector    connectors?              @relation(fields: [organization_id, connector_id], references: [organization_id, id], onDelete: Restrict)
  runtime      runtimes?                @relation(fields: [organization_id, runtime_id], references: [organization_id, id], onDelete: Restrict)
  agent_links  agent_connection_links[]

  @@unique([organization_id, name])
  @@unique([organization_id, id])
}

/// 組織 Installation を Agent Project の Preview / Production へ許可するリンク
model agent_connection_links {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String   @db.Uuid
  agent_id             String   @db.Uuid
  connector_id         String   @db.Uuid
  connection_id        String   @db.Uuid
  /// staging は Preview、production は本番として扱う（Manifest v1 互換）
  stage                String
  /// 許可した Tool name の配列
  allowed_capabilities Json     @default("[]")
  created_by           String?  @db.Uuid
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  agent        agents        @relation(fields: [organization_id, agent_id], references: [organization_id, id], onDelete: Cascade)
  connector    connectors    @relation(fields: [organization_id, connector_id], references: [organization_id, id], onDelete: Restrict)
  connection   connections   @relation(fields: [organization_id, connection_id], references: [organization_id, id], onDelete: Restrict)

  @@unique([agent_id, stage, connector_id])
  @@unique([organization_id, id])
}

/// Agent Project の環境別 Variables。Secret は格納しない
model agent_environment_configs {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  agent_id        String   @db.Uuid
  stage           String
  variables       Json     @default("{}")
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  agent        agents        @relation(fields: [organization_id, agent_id], references: [organization_id, id], onDelete: Cascade)

  @@unique([agent_id, stage])
  @@unique([organization_id, id])
}

/// 組織全体に適用するポリシー（POL-06: 組織 → Agent → ツールの順に継承）
model policies {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  name            String
  rule            Json
  enabled         Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, name])
}

/// 組織Policyが承認者になる自動承認設定。Secretや認証情報は保持しない。
model organization_auto_approval_policies {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String    @unique @db.Uuid
  version              Int       @default(1)
  config               Json
  emergency_stopped_at DateTime? @db.Timestamptz(6)
  created_by           String?   @db.Uuid
  updated_by           String?   @db.Uuid
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  organization organizations                                @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  versions     organization_auto_approval_policy_versions[]

  @@unique([organization_id, id])
}

/// 自動承認Policyの変更履歴。実行時の承認記録からversionを追跡できるようsnapshotを保持する。
model organization_auto_approval_policy_versions {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  policy_id       String   @db.Uuid
  version         Int
  config          Json
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization organizations                       @relation(fields: [organization_id], references: [id], onDelete: Cascade, map: "organization_auto_approval_policy_versions_organization_id_fkey")
  policy       organization_auto_approval_policies @relation(fields: [organization_id, policy_id], references: [organization_id, id], onDelete: Cascade, map: "organization_auto_approval_policy_versions_policy_fkey")

  @@unique([policy_id, version], map: "organization_auto_approval_policy_versions_policy_id_version_ke")
  @@unique([organization_id, id], map: "organization_auto_approval_policy_versions_organization_id_id_k")
}

/// 登録済みの Runtime（企業 × 環境の Execution Plane）
model runtimes {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String    @db.Uuid
  name               String
  stage              String
  /// studio_managed / customer_owned
  provisioning_type  String
  aws_account_id     String?
  aws_region         String
  expected_role_name String
  /// provisioning / pending / active / degraded / offline / revoked
  status             String    @default("pending")
  /// Studio-managed Runtime の自動構築状態。customer_owned では null。
  provisioning_status     String?
  provisioning_step       String?
  provisioning_progress   Int       @default(0)
  provisioning_error      String?
  provisioning_request_id String?
  provisioning_account_name String?
  provisioning_account_email String?
  provisioning_tenant_short String?
  /// Terraform outputs needed to resume bootstrap configuration after a worker restart.
  provisioning_outputs     Json      @default("{}")
  provisioning_lease_owner String?
  provisioning_lease_until DateTime? @db.Timestamptz(6)
  provisioning_started_at DateTime?  @db.Timestamptz(6)
  provisioning_completed_at DateTime? @db.Timestamptz(6)
  provisioning_attempts   Int       @default(0)
  controller_version String?
  /// Session Worker から見た Tool Gateway の MCP エンドポイント（Controller が報告する）
  gateway_url        String?
  tool_catalog       Json      @default("[]")
  /// Controller自身の管理能力（builder_workspace等）。業務Tool Catalogとは分離する。
  capabilities       Json      @default("[]")
  last_heartbeat_at  DateTime? @db.Timestamptz(6)
  registered_at      DateTime? @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  organization     organizations                @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  bootstrap_tokens runtime_bootstrap_tokens[]
  profiles         runtime_profiles[]
  connections      connections[]
  sessions         agent_sessions[]
  builder_sessions builder_workspace_sessions[]
  adapter_packages builder_adapter_packages[]
  jobs             runtime_jobs[]
  browser_profiles browser_profiles[]

  /// 1つの AWS プリンシパルは、全組織を通じて1つの Runtime にしか対応しない
  @@unique([aws_account_id, expected_role_name])
  @@unique([organization_id, id])
  @@index([provisioning_status, provisioning_lease_until, created_at], map: "runtimes_provisioning_status_provisioning_lease_until_created_a")
}

model runtime_bootstrap_tokens {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  runtime_id      String    @db.Uuid
  token_hash      String    @unique
  expires_at      DateTime  @db.Timestamptz(6)
  consumed_at     DateTime? @db.Timestamptz(6)
  created_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  runtime      runtimes      @relation(fields: [organization_id, runtime_id], references: [organization_id, id], onDelete: Cascade)
}

/// 実行環境の設定（ENV）
model runtime_profiles {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  key             String
  name            String
  /// none / openai_hosted / self_hosted
  type            String
  template        String?
  network         Json?
  runtime_id      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization organizations  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  runtime      runtimes?      @relation(fields: [organization_id, runtime_id], references: [organization_id, id], onDelete: Restrict)
  deployments  deployments[]
  builds       agent_builds[]

  @@unique([organization_id, key])
  @@unique([organization_id, id])
}

/// Capability 解決・Tool version・Policy・Runtime profile を固定した Immutable Build
model agent_builds {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String   @db.Uuid
  agent_id           String   @db.Uuid
  agent_version_id   String   @db.Uuid
  runtime_profile_id String   @db.Uuid
  build_number       Int
  /// ready / failed
  status             String   @default("ready")
  resolution         Json     @default("{}")
  compiled_config    Json
  build_log          Json     @default("[]")
  created_by         String?  @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  organization     organizations      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  agent            agents             @relation(fields: [organization_id, agent_id], references: [organization_id, id], onDelete: Cascade)
  agent_version    agent_versions     @relation(fields: [organization_id, agent_version_id], references: [organization_id, id], onDelete: Restrict)
  runtime_profile  runtime_profiles   @relation(fields: [organization_id, runtime_profile_id], references: [organization_id, id], onDelete: Restrict)
  deployments      deployments[]
  builder_releases builder_releases[]

  @@unique([agent_id, build_number])
  @@unique([organization_id, id])
}

/// Run専用Artifact。本文はS3に置き、Control Plane DBには検証済みメタデータだけを保持する。
model run_artifacts {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  run_id          String   @db.Uuid
  path            String
  object_key      String
  mime_type       String
  size_bytes      Int
  sha256          String
  /// pending / passed / rejected / failed
  scan_status     String   @default("pending")
  scan_engine     String?
  source          String
  retained_until  DateTime @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  run          runs          @relation(fields: [organization_id, run_id], references: [organization_id, id], onDelete: Cascade)

  @@unique([organization_id, run_id, path])
  @@unique([organization_id, id])
  @@index([run_id, scan_status])
  @@index([retained_until])
}

/// Cookieやstorage state本文を持たない、Runtime Browser ProfileのControl Planeメタデータ。
model browser_profiles {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String    @db.Uuid
  runtime_id         String    @db.Uuid
  project_id         String?   @db.Uuid
  provider_key       String
  display_name       String
  environment        String
  allowed_domains    Json
  /// pending / active / expired / revoked
  status             String    @default("pending")
  /// Runtime内の暗号化Objectを指すopaque key。内容や署名URLは保持しない。
  runtime_object_key String?
  last_verified_at   DateTime? @db.Timestamptz(6)
  expires_at         DateTime? @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  created_by         String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  organization   organizations            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  runtime        runtimes                 @relation(fields: [organization_id, runtime_id], references: [organization_id, id], onDelete: Restrict, map: "browser_profiles_runtime_fkey")
  project        builder_projects?        @relation(fields: [organization_id, project_id], references: [organization_id, id], onDelete: Restrict, map: "browser_profiles_project_fkey")
  login_sessions browser_login_sessions[]

  @@unique([organization_id, id])
  @@index([organization_id, provider_key, environment, status], map: "browser_profiles_organization_id_provider_key_environment_statu")
}

