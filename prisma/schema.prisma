/// Builder Orchestrator の1試行。lease によりプロセス再起動後も別 Worker が再開できる。
model builder_runs {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  project_id        String    @db.Uuid
  attempt           Int
  status            String    @default("queued")
  budget            Json      @default("{}")
  correlation_id    String    @db.Uuid
  lease_owner       String?
  lease_until       DateTime? @db.Timestamptz(6)
  error_class       String?
  error             String?
  /// 同じ原因の無限反復を防ぐ、正規化済みエラーのSHA-256
  error_fingerprint String?
  retryable         Boolean?
  next_action       String?
  /// 自動再試行のbackoffが終わる時刻
  not_before        DateTime? @db.Timestamptz(6)
  /// 直近のValidation/Audit等の証跡ID
  last_evidence_id  String?   @db.Uuid
  started_at        DateTime? @db.Timestamptz(6)
  finished_at       DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  organization organizations      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      builder_projects   @relation(fields: [organization_id, project_id], references: [organization_id, id], onDelete: Cascade)
  steps        builder_steps[]
  releases     builder_releases[]

  @@unique([organization_id, id])
  @@unique([project_id, attempt])
  @@index([status, not_before, lease_until, created_at])
}

/// 冪等に再開する最小単位。input_hash は後続フェーズで成功 Step を再利用するときの判定に使う。
