{
  "name": "@agent-studio/tool-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Tool Gateway（顧客 AWS で動く。ツール呼び出しの認可・ポリシー・承認・監査・認証情報の注入）",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agent-studio/contracts": "workspace:^",
    "@aws-sdk/client-secrets-manager": "^3.900.0",
    "@aws-sdk/client-ssm": "^3.900.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pino": "^10.3.1",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}
