{
  "name": "@agent-studio/api",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Studio API（Control Plane）",
  "type": "module",
  "scripts": {
    "dev": "PORT=${PORT:-3200} tsx watch --env-file-if-exists=../../.env src/index.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:bootstrap": "tsx --env-file-if-exists=../../.env src/scripts/db-bootstrap.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agent-studio/contracts": "workspace:^",
    "@anthropic-ai/sdk": "^0.120.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.900.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/client-secrets-manager": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@hono/node-server": "^1.19.17",
    "@hono/zod-validator": "^0.9.1",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "aws-jwt-verify": "^5.2.1",
    "dotenv": "^17.2.3",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "openai": "^7.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prisma": "^7.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}
