{
  "name": "@agent-studio/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Studio 共通の型・スキーマ（Manifest / Policy / API / Runtime プロトコル）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
