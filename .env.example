# ---- DB（ローカル: docker compose の postgres） ----
# マイグレーション用（テーブル所有者）
DIRECT_URL=postgresql://postgres:postgres@localhost:5434/agent_studio
# アプリ用（RLS が効くロール。BYPASSRLS なし）
DATABASE_URL=postgresql://agent_studio_app:agent_studio_app@localhost:5434/agent_studio
APP_DB_PASSWORD=agent_studio_app

# ---- 公開URL（Preview画面とAgent API URLの生成） ----
PUBLIC_BASE_URL=http://localhost:3201
PUBLIC_API_BASE_URL=http://localhost:3200

# ---- シークレットの保管（ローカル） ----
# file: SECRETS_FILE の JSON に保存する。API と Worker が同じファイルを見るので、
#       画面から登録した OpenAI のキーが Worker にも反映される（memory はプロセス内だけ）
SECRETS_MODE=file
SECRETS_FILE=.secrets.local.json

# ---- Qiita OAuth（Qiitaのアプリケーション設定で発行） ----
# Callback URL: http://localhost:3201/integrations/qiita/oauth/callback
QIITA_OAUTH_CLIENT_ID=
QIITA_OAUTH_CLIENT_SECRET=

# ---- Orca Router（任意。管理画面で組織ごとのキーを設定する場合は不要） ----
# チェックをONにした対応処理だけで使い、OpenAI Agents APIには渡さない。
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1

# ---- Worker の自己復旧 ----
# OpenAI が入力を202で受け付けてもTurnを開始しない場合、旧Sessionを閉じて自動再作成する。
AGENT_TURN_START_TIMEOUT_SECONDS=45
AGENT_TURN_MAX_RECOVERIES=2
